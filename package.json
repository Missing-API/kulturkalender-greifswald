{
  "name": "kulturkalender-greifswald",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "next dev",
    "prebuild": "tsx scripts/warm-venues.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm lint && pnpm test:coverage",
    "check:full": "pnpm typecheck && pnpm lint && pnpm build && pnpm test:coverage",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e:live": "vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "@schafevormfenster/data-text-mapper": "^0.2.3",
    "@schafevormfenster/rest-commons": "^0.1.11",
    "@schafevormfenster/ts-rest-zod-handler": "^0.1.8",
    "@ts-rest/core": "^3.52.1",
    "@ts-rest/open-api": "^3.52.1",
    "cheerio": "^1.2.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "swagger-ui-react": "^5.35.1",
    "ts-ics": "^2.4.9",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@schafevormfenster/eslint-config": "^0.0.24",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/swagger-ui-react": "^5.18.0",
    "@vitest/coverage-v8": "^5.1.1",
    "@vitest/ui": "^5.1.1",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "node-ical": "^0.27.6",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "@schafevormfenster/eslint-config>typescript": "6"
      }
    },
    "overrides": {
      "baseline-browser-mapping@^2": "^2.11.0",
      "brace-expansion@^1": "^1.1.20",
      "brace-expansion@^5": "^5.0.11",
      "browserslist@^4": "^4.28.7",
      "minimatch@^10": "^10.2.3",
      "source-map-js@^1": "^1.2.2",
      "undici@^7": "^7.30.1"
    }
  }
}
